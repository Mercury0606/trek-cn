# Copy this file to .env and replace the key with the output of:
# openssl rand -hex 32
ENCRYPTION_KEY=
TZ=Asia/Shanghai
DEFAULT_LANGUAGE=zh

# Change to 3001 if another local TREK instance already uses port 3000.
TREK_PORT=3000

# Optional first-boot administrator. These values are only used when no user exists.
# ADMIN_EMAIL=admin@example.local
# ADMIN_PASSWORD=change-this-on-first-login

